# QuickCommerce API Configuration
QUICKCOMMERCE_API_KEY=

# QuickCommerce API Base URL
QUICKCOMMERCE_BASE_URL=https://api.quickcommerceapi.com

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quickcompare

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Cache TTL (in seconds)
CACHE_TTL=60

# Application Environment
ENVIRONMENT=development

# Default location (Chennai)
DEFAULT_LATITUDE=13.0827
DEFAULT_LONGITUDE=80.2707

# Default platforms
DEFAULT_PLATFORMS=BlinkIt,Zepto,Swiggy

# CORS
FRONTEND_URL=http://localhost:3000
